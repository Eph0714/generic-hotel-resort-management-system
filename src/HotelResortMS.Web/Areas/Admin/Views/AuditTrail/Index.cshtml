@model HotelResortMS.Web.Areas.Admin.Models.AuditTrailViewModel
@using HotelResortMS.Core.Common
@{
    ViewData["Title"] = "Audit Trail";
    var isSuperAdmin = User.IsInRole(SystemRoles.SuperAdmin);
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h3 class="mb-0">Audit Trail</h3>
        <p class="text-muted small mb-0">
            Entries older than <strong>@Model.RetentionDays day@(Model.RetentionDays == 1 ? "" : "s")</strong> are deleted automatically.
            @if (isSuperAdmin)
            {
                <text>Configurable under <strong>Audit.RetentionDays</strong> in System Settings.</text>
            }
        </p>
    </div>
    @if (isSuperAdmin)
    {
        <form asp-action="ClearAll" method="post" onsubmit="return confirm('Permanently delete EVERY audit trail entry? This cannot be undone.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-danger">Clear All</button>
        </form>
    }
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="module" class="form-select form-select-sm">
            <option value="">All Modules</option>
            @foreach (var m in Model.Modules)
            {
                <option value="@m" selected="@(m == Model.ModuleFilter)">@m</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
    </div>
</form>

<div class="table-responsive">
<table class="table table-sm bg-white">
    <thead>
        <tr>
            <th>Date/Time</th>
            <th>Business Date</th>
            <th>User</th>
            <th>Module</th>
            <th>Action</th>
            <th>Record</th>
            <th>Reason</th>
            @if (isSuperAdmin)
            {
                <th class="text-end">Actions</th>
            }
        </tr>
    </thead>
    <tbody>
    @foreach (var log in Model.Logs)
    {
        <tr>
            <td>@log.ActualDateTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>@log.BusinessDate.ToString("yyyy-MM-dd")</td>
            <td>@log.UserName</td>
            <td>@log.Module</td>
            <td>@log.Action</td>
            <td>@log.RecordId</td>
            <td>@log.Reason</td>
            @if (isSuperAdmin)
            {
                <td class="text-end">
                    <form asp-action="DeleteEntry" asp-route-id="@log.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this audit trail entry? This cannot be undone.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            }
        </tr>
    }
    </tbody>
</table>
</div>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination pagination-sm">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-route-page="@p" asp-route-module="@Model.ModuleFilter" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">@p</a>
                </li>
            }
        </ul>
    </nav>
}

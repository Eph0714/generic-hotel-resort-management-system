@model HotelResortMS.Web.Areas.Admin.Models.AuditTrailViewModel
@{
    ViewData["Title"] = "Audit Trail";
}
<h3 class="mb-3">Audit Trail</h3>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="module" class="form-select form-select-sm">
            <option value="">All Modules</option>
            @foreach (var m in Model.Modules)
            {
                <option value="@m" selected="@(m == Model.ModuleFilter)">@m</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
    </div>
</form>

<div class="table-responsive">
<table class="table table-sm bg-white">
    <thead>
        <tr>
            <th>Date/Time</th>
            <th>Business Date</th>
            <th>User</th>
            <th>Module</th>
            <th>Action</th>
            <th>Record</th>
            <th>Reason</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var log in Model.Logs)
    {
        <tr>
            <td>@log.ActualDateTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>@log.BusinessDate.ToString("yyyy-MM-dd")</td>
            <td>@log.UserName</td>
            <td>@log.Module</td>
            <td>@log.Action</td>
            <td>@log.RecordId</td>
            <td>@log.Reason</td>
        </tr>
    }
    </tbody>
</table>
</div>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination pagination-sm">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-route-page="@p" asp-route-module="@Model.ModuleFilter" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">@p</a>
                </li>
            }
        </ul>
    </nav>
}

@model List<HotelResortMS.Web.Areas.Admin.Models.RoleListItemViewModel>
@{
    ViewData["Title"] = "Roles";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Roles &amp; Permissions</h3>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Add New</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="table-responsive">
<table class="table table-sm table-hover align-middle bg-white">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Type</th>
            <th>Users</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.Name</td>
            <td>@r.Description</td>
            <td>@(r.IsSystemRole ? "System" : "Custom")</td>
            <td>@r.UserCount</td>
            <td class="text-end">
                <a asp-action="Permissions" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Permissions</a>
                @if (!r.IsSystemRole)
                {
                    <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this role?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

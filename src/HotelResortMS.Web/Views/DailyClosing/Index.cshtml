@model HotelResortMS.Core.Entities.DailyClosingRecord
@{
    ViewData["Title"] = "Daily Closing";
}
<h3 class="mb-3">Daily Closing</h3>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="bg-white p-4 rounded border" style="max-width:520px">
    <div class="table-responsive">
    <table class="table table-sm">
        <tr><td>Beginning Cash</td><td class="text-end">@Model.BeginningCash.ToString("N2")</td></tr>
        <tr><td>Gross Revenue</td><td class="text-end">@Model.GrossRevenue.ToString("N2")</td></tr>
        <tr><td>Discounts</td><td class="text-end">-@Model.DiscountAmount.ToString("N2")</td></tr>
        <tr class="fw-semibold"><td>Net Revenue</td><td class="text-end">@Model.NetRevenue.ToString("N2")</td></tr>
        <tr><td>Cash Receipts</td><td class="text-end">@Model.CashReceipts.ToString("N2")</td></tr>
        <tr><td>Credit/Receivable Sales</td><td class="text-end">@Model.CreditSales.ToString("N2")</td></tr>
        <tr><td>Expenses (Cash)</td><td class="text-end">-@Model.ExpensesCash.ToString("N2")</td></tr>
        <tr><td>Expenses (Other)</td><td class="text-end">@Model.ExpensesOther.ToString("N2")</td></tr>
        <tr class="fw-bold border-top"><td>Expected Ending Cash</td><td class="text-end">@Model.ExpectedEndingCash.ToString("N2")</td></tr>
    </table>
    </div>

    <form asp-action="Close" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Actual Cash Count</label>
            <input type="number" step="0.01" name="actualCashCount" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Remarks (explain any variance)</label>
            <textarea name="remarks" class="form-control"></textarea>
        </div>
        <button type="submit" class="btn btn-success">Close Business Date</button>
        <a asp-controller="BusinessDate" asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </form>
</div>

@model List<HotelResortMS.Core.Entities.Equipment>
@{
    ViewData["Title"] = "Equipment";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Equipment</h3>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Add New</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>Name</th><th>Room</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.Name</td>
            <td>@e.Room?.RoomNumber</td>
            <td>@(e.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                @if (e.IsActive)
                {
                    <form asp-action="Deactivate" asp-route-id="@e.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                    </form>
                }
                <form asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline" onsubmit="return confirm('Permanently delete this equipment? This cannot be undone. It will be blocked if it has any history.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@model HotelResortMS.Web.Models.Amenities.AmenityEditViewModel
@{
    ViewData["Title"] = "Add Amenity";
}
<h3 class="mb-3">Add Amenity</h3>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Create" method="post" class="bg-white p-3 rounded border" style="max-width:560px">
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3">
        <label asp-for="AmenityCategoryId" class="form-label"></label>
        <select asp-for="AmenityCategoryId" class="form-select">
            <option value="">-- Select --</option>
            @foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }
        </select>
    </div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="mb-3"><label asp-for="Capacity" class="form-label"></label><input asp-for="Capacity" type="number" class="form-control" /></div>
    <div class="row">
        <div class="col-6 mb-3"><label asp-for="HourlyRate" class="form-label"></label><input asp-for="HourlyRate" type="number" step="0.01" class="form-control" /></div>
        <div class="col-6 mb-3"><label asp-for="DailyRate" class="form-label"></label><input asp-for="DailyRate" type="number" step="0.01" class="form-control" /></div>
        <div class="col-6 mb-3"><label asp-for="RegularRate" class="form-label"></label><input asp-for="RegularRate" type="number" step="0.01" class="form-control" /></div>
        <div class="col-6 mb-3"><label asp-for="WeekendRate" class="form-label"></label><input asp-for="WeekendRate" type="number" step="0.01" class="form-control" /></div>
        <div class="col-6 mb-3"><label asp-for="HolidayRate" class="form-label"></label><input asp-for="HolidayRate" type="number" step="0.01" class="form-control" /></div>
        <div class="col-6 mb-3"><label asp-for="SeasonalRate" class="form-label"></label><input asp-for="SeasonalRate" type="number" step="0.01" class="form-control" /></div>
        <div class="col-6 mb-3"><label asp-for="MinimumHours" class="form-label"></label><input asp-for="MinimumHours" type="number" class="form-control" /></div>
        <div class="col-6 mb-3"><label asp-for="AdditionalChargePerHour" class="form-label"></label><input asp-for="AdditionalChargePerHour" type="number" step="0.01" class="form-control" /></div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

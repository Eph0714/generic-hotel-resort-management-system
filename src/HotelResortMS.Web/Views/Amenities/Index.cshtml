@model List<HotelResortMS.Core.Entities.Amenity>
@{
    ViewData["Title"] = "Amenities";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Amenities</h3>
    <div>
        <a asp-action="StatusBoard" class="btn btn-outline-secondary btn-sm">Status Board</a>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Add New</a>
    </div>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>Name</th><th>Category</th><th>Capacity</th><th>Regular Rate</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td>@a.Name</td>
            <td>@a.AmenityCategory?.Name</td>
            <td>@a.Capacity</td>
            <td>@a.RegularRate.ToString("N2")</td>
            <td><span class="badge bg-secondary">@a.Status</span></td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                @if (a.IsActive)
                {
                    <form asp-action="Deactivate" asp-route-id="@a.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                    </form>
                }
                <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('Permanently delete this amenity? This cannot be undone. It will be blocked if it has any history.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

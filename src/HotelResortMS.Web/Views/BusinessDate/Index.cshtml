@model HotelResortMS.Core.Entities.BusinessDate
@{
    ViewData["Title"] = "Business Date";
}
<h3 class="mb-3">Business Date</h3>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="bg-white p-4 rounded border" style="max-width:520px">
    <p class="mb-1">Current Business Date</p>
    <h2 class="mb-3">@Model.Date.ToString("MMMM d, yyyy")</h2>
    <p><span class="badge bg-secondary">@Model.Status</span></p>

    <div class="table-responsive">
    <table class="table table-sm">
        <tr><td>Opened</td><td>@Model.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") by @Model.OpenedBy</td></tr>
        <tr><td>Beginning Cash</td><td>@Model.BeginningCash.ToString("N2")</td></tr>
        @if (Model.NightAuditStartedAt is not null)
        {
            <tr><td>Night Audit</td><td>@Model.NightAuditStartedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") by @Model.NightAuditBy</td></tr>
        }
        @if (Model.ClosedAt is not null)
        {
            <tr><td>Closed</td><td>@Model.ClosedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") by @Model.ClosedBy</td></tr>
            <tr><td>Ending Cash</td><td>@Model.EndingCash?.ToString("N2")</td></tr>
        }
    </table>
    </div>

    <div class="d-flex gap-2 mt-3">
        @if (Model.Status == HotelResortMS.Core.Entities.BusinessDate.DateStatus.Open)
        {
            <a asp-controller="NightAudit" asp-action="Index" class="btn btn-primary">Run Night Audit</a>
        }
        @if (Model.Status == HotelResortMS.Core.Entities.BusinessDate.DateStatus.NightAuditInProgress)
        {
            <a asp-controller="DailyClosing" asp-action="Index" class="btn btn-success">Daily Closing</a>
        }
        @if (Model.Status == HotelResortMS.Core.Entities.BusinessDate.DateStatus.Closed)
        {
            <form asp-action="OpenNextDay" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">Open Next Business Day</button>
            </form>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#reopenModal">Reopen</button>
        }
    </div>
</div>

@if (Model.Status == HotelResortMS.Core.Entities.BusinessDate.DateStatus.Closed)
{
    <div class="modal fade" id="reopenModal" tabindex="-1">
        <div class="modal-dialog"><div class="modal-content">
            <form asp-controller="DailyClosing" asp-action="Reopen" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header"><h5 class="modal-title">Reopen @Model.Date.ToString("MMMM d, yyyy")</h5></div>
                <div class="modal-body"><input type="text" name="reason" class="form-control" placeholder="Reason (required)" required /></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reopen</button>
                </div>
            </form>
        </div></div>
    </div>
}

@model List<HotelResortMS.Core.Entities.MaintenanceRequest>
@{
    ViewData["Title"] = "Maintenance Requests";
    var staff = (List<HotelResortMS.Core.Entities.Identity.ApplicationUser>)ViewBag.Staff;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Maintenance Requests</h3>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Add New</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>Request #</th><th>Category</th><th>Room/Equipment</th><th>Description</th><th>Status</th><th>Assigned</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.RequestNumber</td>
            <td>@m.MaintenanceCategory?.Name</td>
            <td>@(m.Room?.RoomNumber ?? m.Equipment?.Name)</td>
            <td>@m.Description</td>
            <td><span class="badge bg-secondary">@m.Status</span></td>
            <td>
                @if (m.Status is HotelResortMS.Core.Entities.MaintenanceRequestStatus.Open or HotelResortMS.Core.Entities.MaintenanceRequestStatus.Assigned)
                {
                    <form asp-action="Assign" asp-route-id="@m.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <select name="assignedToUserId" class="form-select form-select-sm d-inline-block" style="width:auto" onchange="this.form.submit()">
                            <option value="">-- Assign --</option>
                            @foreach (var s in staff)
                            {
                                <option value="@s.Id" selected="@(s.Id == m.AssignedToUserId)">@s.FullName</option>
                            }
                        </select>
                    </form>
                }
                else
                {
                    @m.AssignedToUser?.FullName
                }
            </td>
            <td class="text-end">
                @if (m.Status is HotelResortMS.Core.Entities.MaintenanceRequestStatus.Open or HotelResortMS.Core.Entities.MaintenanceRequestStatus.Assigned)
                {
                    <form asp-action="Start" asp-route-id="@m.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-primary">Start</button>
                    </form>
                }
                @if (m.Status == HotelResortMS.Core.Entities.MaintenanceRequestStatus.InProgress)
                {
                    <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#completeModal-@m.Id">Complete</button>
                    <div class="modal fade" id="completeModal-@m.Id" tabindex="-1">
                        <div class="modal-dialog"><div class="modal-content">
                            <form asp-action="Complete" asp-route-id="@m.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header"><h5 class="modal-title">Complete Request @m.RequestNumber</h5></div>
                                <div class="modal-body">
                                    <label class="form-label">Cost (optional)</label>
                                    <input type="number" step="0.01" name="cost" class="form-control mb-2" />
                                    <label class="form-label">Notes</label>
                                    <textarea name="notes" class="form-control"></textarea>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-success">Complete</button>
                                </div>
                            </form>
                        </div></div>
                    </div>
                }
                @if (m.Status is HotelResortMS.Core.Entities.MaintenanceRequestStatus.Open or HotelResortMS.Core.Entities.MaintenanceRequestStatus.Assigned or HotelResortMS.Core.Entities.MaintenanceRequestStatus.InProgress)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal-@m.Id">Cancel</button>
                    <div class="modal fade" id="cancelModal-@m.Id" tabindex="-1">
                        <div class="modal-dialog"><div class="modal-content">
                            <form asp-action="Cancel" asp-route-id="@m.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header"><h5 class="modal-title">Cancel Request @m.RequestNumber</h5></div>
                                <div class="modal-body"><input type="text" name="reason" class="form-control" placeholder="Reason (required)" required /></div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                                    <button type="submit" class="btn btn-danger">Cancel Request</button>
                                </div>
                            </form>
                        </div></div>
                    </div>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

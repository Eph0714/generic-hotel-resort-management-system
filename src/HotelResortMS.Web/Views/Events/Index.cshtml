@model List<HotelResortMS.Core.Entities.Event>
@{
    ViewData["Title"] = "Events";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Events</h3>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Add New</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>Event #</th><th>Type</th><th>Venue</th><th>Client</th><th>Start</th><th class="text-end">Total</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var ev in Model)
    {
        <tr>
            <td>@ev.EventNumber</td>
            <td>@ev.EventType?.Name</td>
            <td>@ev.EventVenue?.Name</td>
            <td>@(ev.Guest is null ? ev.ClientName : $"{ev.Guest.LastName}, {ev.Guest.FirstName}")</td>
            <td>@ev.StartDateTime.ToString("yyyy-MM-dd HH:mm")</td>
            <td class="text-end">@ev.TotalAmount.ToString("N2")</td>
            <td><span class="badge bg-secondary">@ev.Status</span></td>
            <td class="text-end">
                @if (ev.Status == HotelResortMS.Core.Entities.EventStatus.Pending)
                {
                    <form asp-action="Confirm" asp-route-id="@ev.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-primary">Confirm</button>
                    </form>
                }
                @if (ev.Status is HotelResortMS.Core.Entities.EventStatus.Confirmed or HotelResortMS.Core.Entities.EventStatus.InProgress)
                {
                    <form asp-action="Complete" asp-route-id="@ev.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-success">Complete</button>
                    </form>
                }
                @if (ev.Status is HotelResortMS.Core.Entities.EventStatus.Pending or HotelResortMS.Core.Entities.EventStatus.Confirmed)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal-@ev.Id">Cancel</button>
                    <div class="modal fade" id="cancelModal-@ev.Id" tabindex="-1">
                        <div class="modal-dialog"><div class="modal-content">
                            <form asp-action="Cancel" asp-route-id="@ev.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header"><h5 class="modal-title">Cancel Event @ev.EventNumber</h5></div>
                                <div class="modal-body"><input type="text" name="reason" class="form-control" placeholder="Reason (required)" required /></div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                                    <button type="submit" class="btn btn-danger">Cancel Event</button>
                                </div>
                            </form>
                        </div></div>
                    </div>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

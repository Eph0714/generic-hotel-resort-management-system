@model HotelResortMS.Web.Models.Sales.DiscountEditViewModel
<input type="hidden" asp-for="Id" />
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
<div class="row">
    <div class="col-6 mb-3">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<HotelResortMS.Core.Entities.DiscountType>()"></select>
    </div>
    <div class="col-6 mb-3">
        <label asp-for="CalculationType" class="form-label"></label>
        <select asp-for="CalculationType" class="form-select" asp-items="Html.GetEnumSelectList<HotelResortMS.Core.Entities.DiscountCalculationType>()"></select>
    </div>
</div>
<div class="row">
    <div class="col-6 mb-3"><label asp-for="Percentage" class="form-label"></label><input asp-for="Percentage" type="number" step="0.01" class="form-control" /></div>
    <div class="col-6 mb-3"><label asp-for="FixedAmount" class="form-label"></label><input asp-for="FixedAmount" type="number" step="0.01" class="form-control" /></div>
</div>
<div class="row">
    <div class="col-6 mb-3"><label asp-for="EffectiveDate" class="form-label"></label><input asp-for="EffectiveDate" class="form-control" /></div>
    <div class="col-6 mb-3"><label asp-for="ExpirationDate" class="form-label"></label><input asp-for="ExpirationDate" class="form-control" /></div>
</div>
<fieldset class="mb-3">
    <legend class="fs-6">Eligible for</legend>
    <div class="form-check form-check-inline"><input asp-for="EligibleForRooms" class="form-check-input" /><label asp-for="EligibleForRooms" class="form-check-label">Rooms</label></div>
    <div class="form-check form-check-inline"><input asp-for="EligibleForAmenities" class="form-check-input" /><label asp-for="EligibleForAmenities" class="form-check-label">Amenities</label></div>
    <div class="form-check form-check-inline"><input asp-for="EligibleForProducts" class="form-check-input" /><label asp-for="EligibleForProducts" class="form-check-label">Products</label></div>
    <div class="form-check form-check-inline"><input asp-for="EligibleForServices" class="form-check-input" /><label asp-for="EligibleForServices" class="form-check-label">Services</label></div>
</fieldset>
<div class="form-check mb-2"><input asp-for="RequiresIdVerification" class="form-check-input" /><label asp-for="RequiresIdVerification" class="form-check-label">Requires verified ID (Senior Citizen/PWD)</label></div>
@if (Model.Id != 0)
{
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
}

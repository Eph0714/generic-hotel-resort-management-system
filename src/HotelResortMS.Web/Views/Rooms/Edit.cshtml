@model HotelResortMS.Web.Models.Rooms.RoomEditViewModel
@{
    ViewData["Title"] = "Edit Room";
}
<h3 class="mb-3">Edit Room</h3>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Edit" method="post" class="bg-white p-3 rounded border" style="max-width:520px">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label asp-for="RoomNumber" class="form-label"></label><input asp-for="RoomNumber" class="form-control" /></div>
    <div class="mb-3"><label asp-for="RoomName" class="form-label"></label><input asp-for="RoomName" class="form-control" /></div>
    <div class="mb-3">
        <label asp-for="RoomTypeId" class="form-label"></label>
        <select asp-for="RoomTypeId" class="form-select">
            @foreach (var rt in Model.RoomTypes) { <option value="@rt.Id">@rt.Name</option> }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="BedTypeId" class="form-label"></label>
        <select asp-for="BedTypeId" class="form-select">
            <option value="">-- None --</option>
            @foreach (var bt in Model.BedTypes) { <option value="@bt.Id">@bt.Name</option> }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="FloorAreaId" class="form-label"></label>
        <select asp-for="FloorAreaId" class="form-select">
            <option value="">-- None --</option>
            @foreach (var fa in Model.FloorAreas) { <option value="@fa.Id">@fa.Name</option> }
        </select>
    </div>
    <div class="mb-3"><label asp-for="Capacity" class="form-label"></label><input asp-for="Capacity" type="number" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@model List<HotelResortMS.Web.Models.Rooms.RoomListItemViewModel>
@{
    ViewData["Title"] = "Rooms";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Rooms</h3>
    <div>
        <a asp-action="StatusBoard" class="btn btn-outline-secondary btn-sm">Status Board</a>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Add New</a>
    </div>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>Room #</th><th>Name</th><th>Type</th><th>Status</th><th>Active</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.RoomNumber</td>
            <td>@r.RoomName</td>
            <td>@r.RoomTypeName</td>
            <td><span class="badge bg-secondary">@r.Status</span></td>
            <td>@(r.IsActive ? "Yes" : "No")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                @if (r.IsActive)
                {
                    <form asp-action="Deactivate" asp-route-id="@r.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                    </form>
                }
                <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Permanently delete this room? This cannot be undone. It will be blocked if the room has any history.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

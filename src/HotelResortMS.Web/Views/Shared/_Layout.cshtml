    </div>

    @* Section 3: keyboard shortcuts to the day-to-day modules, plus this help modal so
       the shortcuts are actually discoverable rather than a hidden feature - opened via
       the topbar button above, Alt+/, or "?" (see the shortcuts.js block below). *@
    <div class="modal fade" id="shortcutsModal" tabindex="-1" aria-labelledby="shortcutsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="shortcutsModalLabel">Keyboard Shortcuts</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var s in shortcuts)
                        {
                            <li class="d-flex justify-content-between py-1">
                                <span>@s.Label</span>
                                <kbd>Alt+@s.Key</kbd>
                            </li>
                        }
                        <li class="d-flex justify-content-between py-1 border-top mt-1 pt-2">
                            <span>Show this list</span>
                            <kbd>Alt+/</kbd>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Section 3: header clock - purely client-side display, never used for any
        // business calculation (Business Date/BusinessDateService is the source of truth
        // for anything financial or operational).
        (function () {
            var el = document.getElementById('topbarClock');
            if (!el) return;
            function tick() {
                el.textContent = new Date().toLocaleString(undefined, {
                    weekday: 'short', year: 'numeric', month: 'short', day: 'numeric',
                    hour: '2-digit', minute: '2-digit'
                });
            }
            tick();
            setInterval(tick, 30000);
        })();

        // Sidebar sections (Operations/Sales/Inventory/Finance/Reports/Administration):
        // each heading is a "parent" for the group of links right after it. Every group
        // starts collapsed on load - except the one containing the page's active link,
        // so navigating somewhere never hides the section you're actually in - and the
        // user expands/collapses any section manually by clicking (or Enter/Space on)
        // its heading. Plain vanilla JS, no new dependency, matching how this sidebar's
        // collapse toggle already works.
        (function () {
            document.querySelectorAll('.app-nav-heading').forEach(function (heading) {
                var group = heading.nextElementSibling;
                if (!group || !group.classList.contains('app-nav-group')) return;

                var hasActiveLink = group.querySelector('.app-nav-link.active') !== null;

                function setState(collapsed) {
                    group.classList.toggle('collapsed', collapsed);
                    heading.classList.toggle('collapsed', collapsed);
                    heading.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
                }

                heading.setAttribute('role', 'button');
                heading.setAttribute('tabindex', '0');
                setState(!hasActiveLink);

                heading.addEventListener('click', function () {
                    setState(!group.classList.contains('collapsed'));
                });
                heading.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        setState(!group.classList.contains('collapsed'));
                    }
                });
            });
        })();

        // Section 3: Alt+<digit> jumps to a frequently-used module from anywhere in the
        // app; Alt+/ (or "?" outside of a text field) opens the shortcuts list above.
        // Target URLs come from the server (via Url.Action in the Razor block above) so
        // they stay correct if routing ever changes, rather than hard-coding paths here.
        (function () {
            var shortcuts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                shortcuts.Where(s => s.Url is not null).Select(s => new { s.Key, s.Url, s.Label })));

            document.addEventListener('keydown', function (e) {
                if (!e.altKey || e.ctrlKey || e.shiftKey || e.metaKey) return;

                if (e.key === '/') {
                    e.preventDefault();
                    var modalEl = document.getElementById('shortcutsModal');
                    if (modalEl && window.bootstrap) {
                        window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
                    }
                    return;
                }

                var match = shortcuts.find(function (s) { return s.Key === e.key; });
                if (match) {
                    e.preventDefault();
                    window.location.href = match.Url;
                }
            });

            // "?" also opens the list (a common convention elsewhere), but only when the
            // user isn't actually typing a literal "?" into a field.
            document.addEventListener('keydown', function (e) {
                if (e.key !== '?' || e.altKey || e.ctrlKey || e.metaKey) return;
                var tag = document.activeElement ? document.activeElement.tagName : '';
                var editable = document.activeElement && document.activeElement.isContentEditable;
                if (tag === 'INPUT' || tag === 'TEXTAREA' || editable) return;
                e.preventDefault();
                var modalEl = document.getElementById('shortcutsModal');
                if (modalEl && window.bootstrap) {
                    window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

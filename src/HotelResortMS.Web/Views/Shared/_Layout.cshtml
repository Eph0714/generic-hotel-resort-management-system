    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @* Theme Color (Admin > System Settings > Branding & Theme) is now a single free-
       choice hex color, same picker UX as the Dashboard Banner Color, not a fixed named
       palette any more. Runs synchronously here in <head> (before the stylesheet even
       finishes, let alone first paint) so there's no flash of the default navy before
       the real color applies. Derives hover/active/border/sidebar-accent/sidebar-bg
       shades from that one base color via simple RGB math - lets a Super Admin pick any
       color at all instead of choosing from six pre-made palettes. *@
    <script>
        (function () {
            var base = '@branding.ThemeColor';
            function toRgb(hex) {
                hex = hex.replace('#', '');
                if (hex.length === 3) { hex = hex.split('').map(function (c) { return c + c; }).join(''); }
                var num = parseInt(hex, 16);
                return [(num >> 16) & 255, (num >> 8) & 255, num & 255];
            }
            function toHex(rgb) {
                return '#' + rgb.map(function (v) {
                    return Math.max(0, Math.min(255, Math.round(v))).toString(16).padStart(2, '0');
                }).join('');
            }
            // pct > 0 lightens toward white, pct < 0 darkens toward black.
            function shade(hex, pct) {
                var rgb = toRgb(hex);
                return toHex(rgb.map(function (v) { return pct >= 0 ? v + (255 - v) * pct : v * (1 + pct); }));
            }
            var root = document.documentElement.style;
            root.setProperty('--navy', base);
            root.setProperty('--navy-hover', shade(base, -0.15));
            root.setProperty('--navy-active', shade(base, -0.3));
            root.setProperty('--navy-border', shade(base, -0.3));
            root.setProperty('--sidebar-accent', shade(base, 0.3));
            root.setProperty('--sidebar-bg', shade(base, -0.55));
        })();
    </script>
</head>

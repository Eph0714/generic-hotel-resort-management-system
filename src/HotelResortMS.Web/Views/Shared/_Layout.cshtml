@using System.Linq
@inject HotelResortMS.Core.Interfaces.IHotelBrandingService HotelBranding
@{
    var branding = await HotelBranding.GetBrandingAsync();
    var hotelName = branding.Name;

    // Section 51: highlights the sidebar link for whatever controller/area is currently
    // rendering, so staff always have a clear "you are here" - computed once here rather
    // than repeated per-link so every link stays a plain one-liner below.
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    // The optional "type" parameter handles the shared multi-type controllers
    // (Lookups/InventoryLookups/EventLookups render several sidebar links off one
    // controller, distinguished only by a ?type= query value) - without it, every
    // link sharing that controller would light up together, or (as actually happened
    // here) NONE of them would, since these links previously passed no ActiveIf at
    // all and their whole section would incorrectly collapse on load.
    string ActiveIf(string controller, string area = "", string? type = null) =>
        string.Equals(controller, currentController, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(area, currentArea, StringComparison.OrdinalIgnoreCase) &&
        (type is null || string.Equals(type, Context.Request.Query["type"].ToString(), StringComparison.OrdinalIgnoreCase))
            ? " active" : "";

    var userRole = User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
        .Select(c => c.Value).FirstOrDefault();

    // Section 3: Alt+<digit> jumps straight to the day-to-day modules staff use most,
    // without introducing a new client-side routing/shortcut library - plain keydown
    // handling further down, with the actual target URLs generated server-side here so
    // they stay correct if routing ever changes. Server-side permission checks on each
    // controller still apply exactly as if the link had been clicked normally - a
    // shortcut to a page a user can't access lands on the same 403 the sidebar would.
    var shortcuts = new (string Key, string? Url, string Label)[]
    {
        ("1", Url.Action("Index", "Dashboard"), "Dashboard"),
        ("2", Url.Action("Index", "Reservations"), "Reservations"),
        ("3", Url.Action("Index", "FrontDesk"), "Front Desk"),
        ("4", Url.Action("Index", "Guests"), "Guests"),
        ("5", Url.Action("Index", "Rooms"), "Rooms"),
        ("6", Url.Action("Index", "Housekeeping"), "Housekeeping"),
        ("7", Url.Action("Index", "POS"), "Point of Sale"),
        ("8", Url.Action("Index", "Reports"), "Reports"),
    };
}
<!DOCTYPE html>
<html lang="en" data-theme="@branding.Theme.ToLowerInvariant()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

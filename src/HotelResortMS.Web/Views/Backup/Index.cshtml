@model List<HotelResortMS.Core.Entities.BackupRecord>
@{
    ViewData["Title"] = "Backup & Restore";
    var lastSuccessful = (HotelResortMS.Core.Entities.BackupRecord?)ViewBag.LastSuccessful;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Backup &amp; Restore</h3>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary btn-sm">Backup Now</button>
    </form>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="alert alert-info">
    <strong>Last Successful Backup:</strong>
    @(lastSuccessful is null ? "Never" : $"{lastSuccessful.FileName} - {lastSuccessful.CompletedAt?.ToLocalTime():yyyy-MM-dd HH:mm}")
</div>

<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>File</th><th class="text-end">Size</th><th>Started</th><th>Status</th><th>Restored</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr>
            <td>@b.FileName</td>
            <td class="text-end">@((b.SizeBytes / 1024.0).ToString("N0")) KB</td>
            <td>@b.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>
                <span class="badge bg-@(b.Status == HotelResortMS.Core.Entities.BackupStatus.Success ? "success" : "danger")">@b.Status</span>
                @if (b.Status == HotelResortMS.Core.Entities.BackupStatus.Failed) { <div class="small text-danger">@b.ErrorMessage</div> }
            </td>
            <td>@(b.RestoredAt is null ? "-" : $"{b.RestoredAt?.ToLocalTime():yyyy-MM-dd HH:mm} by {b.RestoredBy}")</td>
            <td class="text-end">
                @if (b.Status == HotelResortMS.Core.Entities.BackupStatus.Success)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#restoreModal-@b.Id">Restore</button>
                    <div class="modal fade" id="restoreModal-@b.Id" tabindex="-1">
                        <div class="modal-dialog"><div class="modal-content">
                            <form asp-action="Restore" asp-route-id="@b.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header"><h5 class="modal-title">Restore from @b.FileName</h5></div>
                                <div class="modal-body">
                                    <div class="alert alert-danger">This will overwrite the ENTIRE live database with the contents of this backup. This cannot be undone.</div>
                                    <label class="form-label">Type <strong>RESTORE</strong> to confirm</label>
                                    <input type="text" name="confirmationText" class="form-control" required />
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Restore Database</button>
                                </div>
                            </form>
                        </div></div>
                    </div>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

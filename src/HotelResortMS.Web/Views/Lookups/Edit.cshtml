@model HotelResortMS.Web.Models.Lookups.LookupEditViewModel
@{
    ViewData["Title"] = "Edit " + Model.Type;
}
<h3 class="mb-3">Edit @Model.Type</h3>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Edit" method="post" class="bg-white p-3 rounded border" style="max-width:420px">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Type" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" asp-route-type="@Model.Type" class="btn btn-outline-secondary">Cancel</a>
</form>

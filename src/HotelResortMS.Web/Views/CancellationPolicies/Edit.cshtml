@model HotelResortMS.Web.Models.Operations.CancellationPolicyEditViewModel
@{
    ViewData["Title"] = "Edit Cancellation Policy";
}
<h3 class="mb-3">Edit Cancellation Policy</h3>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Edit" method="post" class="bg-white p-3 rounded border" style="max-width:520px">
    @await Html.PartialAsync("_Form", Model)
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@model HotelResortMS.Web.Models.Operations.MaintenanceCategoryEditViewModel
@{
    ViewData["Title"] = "Add Maintenance Category";
}
<h3 class="mb-3">Add Maintenance Category</h3>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Create" method="post" class="bg-white p-3 rounded border" style="max-width:420px">
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

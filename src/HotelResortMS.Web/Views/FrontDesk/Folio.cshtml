@model HotelResortMS.Core.Entities.GuestFolio
@{
    ViewData["Title"] = "Folio " + Model.FolioNumber;
    var balance = Model.Details.Sum(d => d.Amount);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Folio @Model.FolioNumber</h3>
    <span class="badge bg-secondary fs-6">@Model.Status</span>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<p class="text-muted">Guest: @Model.Guest?.FirstName @Model.Guest?.LastName</p>

<div class="table-responsive mb-3">
<table class="table table-sm bg-white">
    <thead><tr><th>Date</th><th>Type</th><th>Description</th><th class="text-end">Amount</th></tr></thead>
    <tbody>
    @foreach (var d in Model.Details.OrderBy(x => x.ActualDateTime))
    {
        <tr>
            <td>@d.ActualDateTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>@d.Type</td>
            <td>@d.Description</td>
            <td class="text-end">@d.Amount.ToString("N2")</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr class="fw-bold">
            <td colspan="3" class="text-end">Balance</td>
            <td class="text-end">@balance.ToString("N2")</td>
        </tr>
    </tfoot>
</table>
</div>

@if (Model.Status == HotelResortMS.Core.Entities.FolioStatus.Open)
{
    <form asp-action="CheckOut" asp-route-reservationId="@Model.ReservationId" method="post" onsubmit="return confirmCheckout(@balance.ToString(System.Globalization.CultureInfo.InvariantCulture), this);">
        @Html.AntiForgeryToken()
        <input type="hidden" name="authorizeOutstandingBalance" id="authOverride_@Model.Id" value="false" />
        <button type="submit" class="btn btn-primary">Check Out</button>
    </form>
}

<script>
    function confirmCheckout(balance, form) {
        if (balance > 0) {
            const ok = confirm(`Outstanding balance of ${balance.toFixed(2)} - authorize checkout with credit anyway?`);
            if (!ok) return false;
            form.querySelector('input[name="authorizeOutstandingBalance"]').value = 'true';
        }
        return true;
    }
</script>

@{
    ViewData["Title"] = "Recipes / Bill of Materials";
    var products = ((IEnumerable<(int Id, string Name, bool HasRecipe)>)ViewBag.Products).ToList();
}
<h3 class="mb-3">Recipes / Bill of Materials</h3>
<p class="text-muted">Only products with "Track Inventory" enabled are listed here (Products screen).</p>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }

<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>Product</th><th>Recipe</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var p in products)
    {
        <tr>
            <td>@p.Name</td>
            <td>@(p.HasRecipe ? "Configured" : "Not set (direct stock item)")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-productId="@p.Id" class="btn btn-sm btn-outline-primary">@(p.HasRecipe ? "Edit Recipe" : "Add Recipe")</a>
                @if (p.HasRecipe)
                {
                    <form asp-action="Remove" asp-route-productId="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this recipe?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

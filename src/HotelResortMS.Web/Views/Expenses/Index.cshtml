@model List<HotelResortMS.Core.Entities.Expense>
@{
    ViewData["Title"] = "Expenses";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Expenses</h3>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Record Expense</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>Expense #</th><th>Date</th><th>Category</th><th>Description</th><th>Payee</th><th class="text-end">Amount</th><th>Method</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var x in Model)
    {
        <tr>
            <td>@x.ExpenseNumber</td>
            <td>@x.BusinessDate.ToString("yyyy-MM-dd")</td>
            <td>@x.Category</td>
            <td>@x.Description</td>
            <td>@x.Payee</td>
            <td class="text-end">@x.Amount.ToString("N2")</td>
            <td>@x.PaymentMethod</td>
            <td><span class="badge bg-@(x.Status == HotelResortMS.Core.Entities.ExpenseStatus.Posted ? "success" : "secondary")">@x.Status</span></td>
            <td class="text-end">
                @if (x.Status == HotelResortMS.Core.Entities.ExpenseStatus.Posted)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#voidModal-@x.Id">Void</button>
                    <div class="modal fade" id="voidModal-@x.Id" tabindex="-1">
                        <div class="modal-dialog"><div class="modal-content">
                            <form asp-action="Void" asp-route-id="@x.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header"><h5 class="modal-title">Void Expense @x.ExpenseNumber</h5></div>
                                <div class="modal-body"><input type="text" name="reason" class="form-control" placeholder="Reason (required)" required /></div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Void</button>
                                </div>
                            </form>
                        </div></div>
                    </div>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@model HotelResortMS.Web.Models.Finance.ExpenseCreateViewModel
@{
    ViewData["Title"] = "Record Expense";
}
<h3 class="mb-3">Record Expense</h3>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Create" method="post" class="bg-white p-3 rounded border" style="max-width:520px">
    <div class="mb-3">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<HotelResortMS.Core.Entities.ExpenseCategory>()"></select>
    </div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" /></div>
    <div class="row">
        <div class="col-6 mb-3"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" type="number" step="0.01" class="form-control" /></div>
        <div class="col-6 mb-3">
            <label asp-for="PaymentMethod" class="form-label"></label>
            <select asp-for="PaymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<HotelResortMS.Core.Entities.PaymentMethod>()"></select>
        </div>
    </div>
    <div class="mb-3"><label asp-for="Payee" class="form-label"></label><input asp-for="Payee" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Reference" class="form-label"></label><input asp-for="Reference" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control"></textarea></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

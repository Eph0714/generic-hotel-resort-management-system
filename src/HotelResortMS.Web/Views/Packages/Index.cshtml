@model List<HotelResortMS.Core.Entities.Package>
@{
    ViewData["Title"] = "Packages";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Packages</h3>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Add New</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }

<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>Name</th><th>Includes</th><th class="text-end">Price</th><th>Effective</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Name</td>
            <td>@string.Join(", ", p.Components.Select(c => $"{c.Quantity}x {c.Description}"))</td>
            <td class="text-end">@p.Price.ToString("N2")</td>
            <td>@p.EffectiveDate.ToString("yyyy-MM-dd")</td>
            <td>@(p.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                @if (p.IsActive)
                {
                    <form asp-action="Deactivate" asp-route-id="@p.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                    </form>
                }
                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Permanently delete this package? This cannot be undone. It will be blocked if it has any history.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

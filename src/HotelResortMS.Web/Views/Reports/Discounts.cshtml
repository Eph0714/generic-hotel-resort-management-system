@model HotelResortMS.Web.Models.Reports.DiscountReportViewModel
@{
    ViewData["Title"] = "Discount Reports";
}
<h3 class="mb-3">Discount Reports</h3>
@await Html.PartialAsync("_FilterBar", Model.Range)

<div class="row g-3 mb-3">
    <div class="col-sm-3"><div class="stat-card"><div class="stat-label">Eligible Amount</div><div class="stat-value">@Model.TotalEligible.ToString("N2")</div></div></div>
    <div class="col-sm-3"><div class="stat-card"><div class="stat-label">Total Discount</div><div class="stat-value">@Model.TotalDiscount.ToString("N2")</div></div></div>
    <div class="col-sm-3"><div class="stat-card"><div class="stat-label">Net (of Eligible)</div><div class="stat-value">@Model.TotalNetOfEligible.ToString("N2")</div></div></div>
    <div class="col-sm-3"><div class="stat-card"><div class="stat-label">Manual Overrides</div><div class="stat-value">@Model.ManualOverrideCount</div></div></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card"><div class="card-header">By Discount Type</div>
        <div class="table-responsive"><table class="table table-sm mb-0">
            <tbody>@foreach (var d in Model.ByDiscount) { <tr><td>@d.DiscountName</td><td class="text-end">@d.Total.ToString("N2")</td></tr> }</tbody>
        </table></div></div>
    </div>
    <div class="col-md-6">
        <div class="card"><div class="card-header">By User</div>
        <div class="table-responsive"><table class="table table-sm mb-0">
            <tbody>@foreach (var u in Model.ByUser) { <tr><td>@u.User</td><td class="text-end">@u.Total.ToString("N2")</td></tr> }</tbody>
        </table></div></div>
    </div>
</div>

<div class="table-responsive">
<table class="table table-sm bg-white">
    <thead><tr><th>Date</th><th>Discount</th><th>Reference</th><th class="text-end">Eligible</th><th class="text-end">Discount</th><th>Override</th><th>Applied By</th></tr></thead>
    <tbody>
    @foreach (var t in Model.Transactions)
    {
        <tr>
            <td>@t.BusinessDate.ToString("yyyy-MM-dd")</td>
            <td>@t.Discount?.Name</td>
            <td>@t.ReferenceType @t.ReferenceId</td>
            <td class="text-end">@t.EligibleAmount.ToString("N2")</td>
            <td class="text-end">@t.DiscountAmount.ToString("N2")</td>
            <td>@(t.IsManualOverride ? "Yes - " + t.OverrideReason : "")</td>
            <td>@t.AppliedBy</td>
        </tr>
    }
    </tbody>
</table>
</div>

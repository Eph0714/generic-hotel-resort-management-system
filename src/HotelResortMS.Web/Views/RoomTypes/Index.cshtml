@model List<HotelResortMS.Core.Entities.RoomType>
@{
    ViewData["Title"] = "Room Types";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Room Types</h3>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Add New</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>Name</th><th>Capacity</th><th>Regular</th><th>Weekend</th><th>Holiday</th><th>Seasonal</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var rt in Model)
    {
        <tr>
            <td>@rt.Name</td>
            <td>@rt.BaseCapacity</td>
            <td>@rt.RegularRate.ToString("N2")</td>
            <td>@rt.WeekendRate.ToString("N2")</td>
            <td>@rt.HolidayRate.ToString("N2")</td>
            <td>@rt.SeasonalRate.ToString("N2")</td>
            <td>@(rt.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@rt.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                @if (rt.IsActive)
                {
                    <form asp-action="Deactivate" asp-route-id="@rt.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                    </form>
                }
                <form asp-action="Delete" asp-route-id="@rt.Id" method="post" class="d-inline" onsubmit="return confirm('Permanently delete this room type? This cannot be undone. It will be blocked if it has any history.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

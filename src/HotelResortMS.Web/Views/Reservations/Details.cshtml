@model HotelResortMS.Core.Entities.Reservation
@{
    ViewData["Title"] = "Reservation " + Model.ReservationNumber;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Reservation @Model.ReservationNumber</h3>
    <span class="badge bg-secondary fs-6">@Model.Status</span>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Guest &amp; Stay</div>
            <div class="card-body">
                <p><strong>Guest:</strong> @Model.Guest?.FirstName @Model.Guest?.LastName</p>
                <p><strong>Check-In:</strong> @Model.CheckInDate.ToString("MMMM d, yyyy")</p>
                <p><strong>Check-Out:</strong> @Model.CheckOutDate.ToString("MMMM d, yyyy")</p>
                <p><strong>Guests:</strong> @Model.NumberOfGuests</p>
                <p class="mb-0"><strong>Special Requests:</strong> @Model.SpecialRequests</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Financials</div>
            <div class="card-body">
                @if (Model.Package is not null)
                {
                    <p><strong>Package:</strong> @Model.Package.Name (@Model.PackagePrice.ToString("N2"))
                        @if (Model.Package.Components.Count > 0)
                        {
                            <span class="text-muted d-block small">Includes: @string.Join(", ", Model.Package.Components.Select(c => $"{c.Quantity}x {c.Description}"))</span>
                        }
                    </p>
                }
                <p><strong>Total:</strong> @Model.TotalAmount.ToString("N2")</p>
                <p><strong>Discount:</strong> @Model.DiscountAmount.ToString("N2")</p>
                <p><strong>Paid:</strong> @Model.AmountPaid.ToString("N2")</p>
                <p class="@(Model.Status == HotelResortMS.Core.Entities.ReservationStatus.Cancelled ? "" : "mb-0")"><strong>Balance Due:</strong> @Model.BalanceDue.ToString("N2")</p>
                @if (Model.Status == HotelResortMS.Core.Entities.ReservationStatus.Cancelled)
                {
                    <p class="mb-0"><strong>Cancellation Fee:</strong> @Model.CancellationFeeAmount.ToString("N2")
                        @if (Model.CancellationPolicy is not null) { <span class="text-muted">(@Model.CancellationPolicy.Name)</span> }
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Rooms</div>
    <div class="table-responsive">
    <table class="table table-sm mb-0">
        <thead><tr><th>Room</th><th>Rate</th></tr></thead>
        <tbody>
        @foreach (var rr in Model.Rooms)
        {
            <tr><td>@rr.Room?.RoomNumber</td><td>@rr.RateAmount.ToString("N2")</td></tr>
        }
        </tbody>
    </table>
    </div>
</div>

<div class="d-flex gap-2">
    @if (Model.Status == HotelResortMS.Core.Entities.ReservationStatus.Confirmed)
    {
        <form asp-controller="FrontDesk" asp-action="CheckIn" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success btn-sm">Check In</button>
        </form>
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return promptCancel(this);">
            @Html.AntiForgeryToken()
            <input type="hidden" name="reason" id="cancelReason_@Model.Id" />
            <button type="submit" class="btn btn-outline-danger btn-sm">Cancel Reservation</button>
        </form>
    }
    @if (Model.Status == HotelResortMS.Core.Entities.ReservationStatus.CheckedIn)
    {
        <a asp-controller="FrontDesk" asp-action="Folio" asp-route-reservationId="@Model.Id" class="btn btn-primary btn-sm">View Folio / Check Out</a>
    }
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

<script>
    function promptCancel(form) {
        const reason = prompt('Reason for cancellation:');
        if (!reason) return false;
        form.querySelector('input[name="reason"]').value = reason;
        return true;
    }
</script>

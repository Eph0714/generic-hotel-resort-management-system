@model List<HotelResortMS.Core.Entities.Income>
@{
    ViewData["Title"] = "Income";
}
<h3 class="mb-3">Income</h3>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="category" class="form-select form-select-sm">
            <option value="">All Categories</option>
            @foreach (var c in Enum.GetValues<HotelResortMS.Core.Entities.IncomeCategory>())
            {
                <option value="@c" selected="@(c.Equals(ViewBag.Category))">@c</option>
            }
        </select>
    </div>
    <div class="col-auto"><input type="date" name="fromDate" class="form-control form-control-sm" /></div>
    <div class="col-auto"><input type="date" name="toDate" class="form-control form-control-sm" /></div>
    <div class="col-auto"><button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button></div>
</form>

<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>Income #</th><th>Date</th><th>Category</th><th>Description</th><th class="text-end">Gross</th><th class="text-end">Discount</th><th class="text-end">Net</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var i in Model)
    {
        <tr>
            <td>@i.IncomeNumber</td>
            <td>@i.BusinessDate.ToString("yyyy-MM-dd")</td>
            <td>@i.Category</td>
            <td>@i.Description</td>
            <td class="text-end">@i.GrossAmount.ToString("N2")</td>
            <td class="text-end">@i.DiscountAmount.ToString("N2")</td>
            <td class="text-end">@i.NetAmount.ToString("N2")</td>
            <td><span class="badge bg-@(i.Status == HotelResortMS.Core.Entities.IncomeStatus.Posted ? "success" : "secondary")">@i.Status</span></td>
            <td class="text-end">
                @if (i.Status == HotelResortMS.Core.Entities.IncomeStatus.Posted)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#voidModal-@i.Id">Void</button>
                    <div class="modal fade" id="voidModal-@i.Id" tabindex="-1">
                        <div class="modal-dialog"><div class="modal-content">
                            <form asp-action="Void" asp-route-id="@i.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header"><h5 class="modal-title">Void Income @i.IncomeNumber</h5></div>
                                <div class="modal-body"><input type="text" name="reason" class="form-control" placeholder="Reason (required)" required /></div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Void</button>
                                </div>
                            </form>
                        </div></div>
                    </div>
                }
            </td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr class="fw-bold">
            <td colspan="4">Total</td>
            <td class="text-end">@Model.Where(i => i.Status == HotelResortMS.Core.Entities.IncomeStatus.Posted).Sum(i => i.GrossAmount).ToString("N2")</td>
            <td class="text-end">@Model.Where(i => i.Status == HotelResortMS.Core.Entities.IncomeStatus.Posted).Sum(i => i.DiscountAmount).ToString("N2")</td>
            <td class="text-end">@Model.Where(i => i.Status == HotelResortMS.Core.Entities.IncomeStatus.Posted).Sum(i => i.NetAmount).ToString("N2")</td>
            <td colspan="2"></td>
        </tr>
    </tfoot>
</table>
</div>

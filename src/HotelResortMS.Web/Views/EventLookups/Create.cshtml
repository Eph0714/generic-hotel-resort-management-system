@model HotelResortMS.Web.Models.Operations.EventLookupEditViewModel
@{
    ViewData["Title"] = "Add " + Model.Type;
}
<h3 class="mb-3">Add @Model.Type</h3>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Create" method="post" class="bg-white p-3 rounded border" style="max-width:420px">
    <input type="hidden" asp-for="Type" />
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    @if (Model.Type == HotelResortMS.Web.Models.Operations.EventLookupType.EventVenue)
    {
        <div class="mb-3"><label asp-for="Capacity" class="form-label"></label><input asp-for="Capacity" type="number" class="form-control" /></div>
    }
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" asp-route-type="@Model.Type" class="btn btn-outline-secondary">Cancel</a>
</form>

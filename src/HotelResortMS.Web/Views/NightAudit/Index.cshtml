@model IReadOnlyList<HotelResortMS.Core.Interfaces.NightAuditException>
@{
    ViewData["Title"] = "Night Audit";
    var businessDate = (HotelResortMS.Core.Entities.BusinessDate)ViewBag.BusinessDate;
}
<h3 class="mb-1">Night Audit</h3>
<p class="text-muted mb-3">Business Date: @businessDate.Date.ToString("MMMM d, yyyy")</p>
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

@if (Model.Count == 0)
{
    <div class="alert alert-success">No exceptions found. Ready to run Night Audit.</div>
    <form asp-action="Run" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary">Run Night Audit</button>
    </form>
}
else
{
    <div class="alert alert-warning">@Model.Count unresolved exception(s) found:</div>
    <div class="table-responsive mb-3">
    <table class="table table-sm bg-white">
        <thead><tr><th>Category</th><th>Message</th></tr></thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr><td>@e.Category</td><td>@e.Message</td></tr>
        }
        </tbody>
    </table>
    </div>

    <form asp-action="Run" method="post" class="bg-white p-3 rounded border" style="max-width:520px">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Override Reason (required to proceed with exceptions)</label>
            <textarea name="overrideReason" class="form-control" required></textarea>
        </div>
        <button type="submit" class="btn btn-warning">Override and Run Night Audit</button>
    </form>
}

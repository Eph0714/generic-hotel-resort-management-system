@model List<HotelResortMS.Core.Entities.Guest>
@{
    ViewData["Title"] = "Guests";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Guests</h3>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Add New</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }

<form method="get" class="d-flex mb-3" style="max-width:320px">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm me-2" placeholder="Search name, email, phone" />
    <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
</form>

<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Type</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var g in Model)
    {
        <tr>
            <td>@g.FirstName @g.LastName</td>
            <td>@g.Email</td>
            <td>@g.Phone</td>
            <td>@g.GuestType</td>
            <td>@(g.IsActive ? "Active" : "Archived")</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@g.Id" class="btn btn-sm btn-outline-secondary">View</a>
                <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                @if (g.IsActive)
                {
                    <form asp-action="Archive" asp-route-id="@g.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Archive</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

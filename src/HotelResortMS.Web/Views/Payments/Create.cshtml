@model HotelResortMS.Web.Models.Sales.PaymentCreateViewModel
@{
    ViewData["Title"] = "Record Payment";
}
<h3 class="mb-3">Record Payment</h3>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Create" method="post" class="bg-white p-3 rounded border" style="max-width:480px">
    <div class="mb-3">
        <label asp-for="GuestId" class="form-label"></label>
        <select asp-for="GuestId" id="guestSelect" class="form-select">
            <option value="">-- Select guest --</option>
            @foreach (var g in Model.Guests)
            {
                <option value="@g.Id">@g.LastName, @g.FirstName</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="GuestFolioId" class="form-label"></label>
        <select asp-for="GuestFolioId" id="folioSelect" class="form-select">
            <option value="">-- None --</option>
        </select>
    </div>
    <div class="mb-3"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" type="number" step="0.01" class="form-control" /></div>
    <div class="mb-3">
        <label asp-for="Method" class="form-label"></label>
        <select asp-for="Method" class="form-select" asp-items="Html.GetEnumSelectList<HotelResortMS.Core.Entities.PaymentMethod>()"></select>
    </div>
    <div class="mb-3"><label asp-for="ReferenceNumber" class="form-label"></label><input asp-for="ReferenceNumber" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
<script>
document.getElementById('guestSelect').addEventListener('change', function (e) {
    const folioSelect = document.getElementById('folioSelect');
    folioSelect.innerHTML = '<option value="">-- None --</option>';
    if (!e.target.value) return;
    fetch('@Url.Action("OpenFolios")?guestId=' + e.target.value)
        .then(function (r) { return r.json(); })
        .then(function (folios) {
            folios.forEach(function (f) {
                const opt = document.createElement('option');
                opt.value = f.id;
                opt.textContent = f.folioNumber;
                folioSelect.appendChild(opt);
            });
        });
});
</script>
}

@model List<HotelResortMS.Core.Entities.PurchaseOrder>
@{
    ViewData["Title"] = "Purchase Orders";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Purchase Orders</h3>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Add New</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>PO #</th><th>Supplier</th><th>Order Date</th><th class="text-end">Total</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var po in Model)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@po.Id">@po.PONumber</a></td>
            <td>@po.Supplier?.Name</td>
            <td>@po.OrderDate.ToString("yyyy-MM-dd")</td>
            <td class="text-end">@po.TotalAmount.ToString("N2")</td>
            <td><span class="badge bg-secondary">@po.Status</span></td>
            <td class="text-end"><a asp-action="Details" asp-route-id="@po.Id" class="btn btn-sm btn-outline-primary">View</a></td>
        </tr>
    }
    </tbody>
</table>
</div>

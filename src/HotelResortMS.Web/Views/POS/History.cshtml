@model List<HotelResortMS.Core.Entities.POSTransaction>
@{
    ViewData["Title"] = "Sale History";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Sale History</h3>
    <a asp-action="Index" class="btn btn-primary btn-sm">New Sale</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>POS #</th><th>Date/Time</th><th>Guest</th><th class="text-end">Net Amount</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td><a asp-action="Receipt" asp-route-id="@s.Id">@s.PosNumber</a></td>
            <td>@s.ActualDateTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>@(s.Guest is null ? "Walk-in" : $"{s.Guest.LastName}, {s.Guest.FirstName}")</td>
            <td class="text-end">@s.NetAmount.ToString("N2")</td>
            <td><span class="badge bg-@(s.Status == HotelResortMS.Core.Entities.POSTransactionStatus.Completed ? "success" : "secondary")">@s.Status</span></td>
            <td class="text-end">
                @if (s.Status == HotelResortMS.Core.Entities.POSTransactionStatus.Completed)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#voidModal-@s.Id">Void</button>
                    <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#refundModal-@s.Id">Refund</button>

                    <div class="modal fade" id="voidModal-@s.Id" tabindex="-1">
                        <div class="modal-dialog"><div class="modal-content">
                            <form asp-action="Void" asp-route-id="@s.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header"><h5 class="modal-title">Void Sale @s.PosNumber</h5></div>
                                <div class="modal-body"><input type="text" name="reason" class="form-control" placeholder="Reason (required)" required /></div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Void</button>
                                </div>
                            </form>
                        </div></div>
                    </div>
                    <div class="modal fade" id="refundModal-@s.Id" tabindex="-1">
                        <div class="modal-dialog"><div class="modal-content">
                            <form asp-action="Refund" asp-route-id="@s.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header"><h5 class="modal-title">Refund Sale @s.PosNumber</h5></div>
                                <div class="modal-body"><input type="text" name="reason" class="form-control" placeholder="Reason (required)" required /></div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-warning">Refund</button>
                                </div>
                            </form>
                        </div></div>
                    </div>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@model HotelResortMS.Web.Models.Inventory.InventoryItemEditViewModel
<input type="hidden" asp-for="Id" />
<div class="row">
    <div class="col-6 mb-3"><label asp-for="Sku" class="form-label"></label><input asp-for="Sku" class="form-control" /></div>
    <div class="col-6 mb-3">
        <label asp-for="UnitOfMeasureId" class="form-label"></label>
        <select asp-for="UnitOfMeasureId" class="form-select">
            <option value="">-- Select --</option>
            @foreach (var u in Model.Units)
            {
                <option value="@u.Id">@u.Name (@u.Abbreviation)</option>
            }
        </select>
    </div>
</div>
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
<div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
<div class="row">
    <div class="col-6 mb-3">
        <label asp-for="InventoryLocationId" class="form-label"></label>
        <select asp-for="InventoryLocationId" class="form-select">
            <option value="">-- Select --</option>
            @foreach (var l in Model.Locations)
            {
                <option value="@l.Id">@l.Name</option>
            }
        </select>
    </div>
    <div class="col-6 mb-3"><label asp-for="Cost" class="form-label"></label><input asp-for="Cost" type="number" step="0.01" class="form-control" /></div>
</div>
<div class="row">
    <div class="col-6 mb-3"><label asp-for="ReorderLevel" class="form-label"></label><input asp-for="ReorderLevel" type="number" step="0.01" class="form-control" /></div>
    <div class="col-6 mb-3"><label asp-for="ExpirationDate" class="form-label"></label><input asp-for="ExpirationDate" class="form-control" /></div>
</div>
@if (Model.Id != 0)
{
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
}

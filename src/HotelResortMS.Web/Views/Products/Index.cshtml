@model List<HotelResortMS.Core.Entities.Product>
@{
    ViewData["Title"] = "Products";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Products</h3>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Add New</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<form method="get" class="d-flex mb-3" style="max-width:320px">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm me-2" placeholder="Search name or SKU" />
    <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
</form>

<div class="table-responsive">
<table class="table table-sm table-hover bg-white">
    <thead><tr><th>SKU</th><th>Name</th><th>Category</th><th>Type</th><th>Price</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Sku</td>
            <td>@p.Name</td>
            <td>@p.ProductCategory?.Name</td>
            <td>@p.Type</td>
            <td>@p.UnitPrice.ToString("N2")</td>
            <td>@(p.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                @if (p.IsActive)
                {
                    <form asp-action="Deactivate" asp-route-id="@p.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                    </form>
                }
                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Permanently delete this product? This cannot be undone. It will be blocked if it has any history.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
